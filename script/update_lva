#!/bin/bash
# Update the Linux Voice Assistant in place from
# https://github.com/imonlinux/linux-voice-assistant
#
# Usage:
#   bash ~/linux-voice-assistant/script/update_lva [options] [setup flags]
#   e.g. bash ~/linux-voice-assistant/script/update_lva --sendspin --tray
#
# How it works:
#   1. Sanity-checks that this directory is the LVA clone with a clean
#      tracked tree (use --force to override).
#   2. Records the current revision for --rollback.
#   3. git fetch + git checkout -B to the target branch.
#   4. Re-executes the freshly updated copy of THIS script, so update
#      logic always runs at the version being deployed to.
#   5. Migrates config.json, rebuilds the virtual environment
#      (script/setup with your flags) and restarts the service.
#
# Untracked per-device files (config.json, preferences.json, Sendspin
# identity/pairing credentials, piper voices, per-model threshold .json
# files, external wake word downloads) are untouched by the update.
#
# Options:
#   --branch NAME   Branch or tag ref to update to (default: main)
#   --force         Proceed even if tracked files have local modifications
#   --rollback      Return to the revision that was checked out before the
#                   last update, then rebuild and restart
#   -h, --help      Show this help
#
# Setup flags (--sendspin, --tray, --dev) are remembered in
# .lva-setup-flags: an update run with flags saves them, and a later
# update without flags reuses them. That keeps the Sendspin extra (and
# piper-tts, which ships in it) installed across routine updates — a bare
# `update_lva` alone would rebuild the venv without it. Explicit flags on
# any update replace the remembered set.
#
# Rollback: if the new version misbehaves, run
#   bash ~/linux-voice-assistant/script/update_lva --rollback
# Roll forward again later by running a normal update.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PARENT_DIR="$(cd "$PROJECT_DIR/.." && pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

REPO_HINT="imonlinux/linux-voice-assistant"
DEFAULT_BRANCH="main"
PREV_REV_FILE="$PROJECT_DIR/.lva-update-previous-rev"
SETUP_FLAGS_FILE="$PROJECT_DIR/.lva-setup-flags"

DAEMON_UNIT="linux-voice-assistant.service"
DAEMON_UNIT_XVF="linux-voice-assistant_xvf3800.service"
TRAY_UNIT="linux-voice-assistant-tray.service"

BRANCH="$DEFAULT_BRANCH"
FORCE=0
ROLLBACK=0
SKIP_FETCH=0
SETUP_ARGS=()

usage() { sed -n '2,39p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
    case "$1" in
        --branch)
            [ $# -ge 2 ] || { echo "error: --branch requires a value" >&2; exit 1; }
            BRANCH="$2"; shift 2 ;;
        --force)    FORCE=1; shift ;;
        --rollback) ROLLBACK=1; shift ;;
        --skip-fetch) SKIP_FETCH=1; shift ;;
        -h|--help)  usage; exit 0 ;;
        *)          SETUP_ARGS+=("$1"); shift ;;
    esac
done

# Remember or reuse the setup flags (see header): explicit flags win and
# are saved; with no flags, reuse the last set so extras (sendspin, tray,
# dev) survive updates — the venv is rebuilt from scratch each time.
if [ ${#SETUP_ARGS[@]} -gt 0 ]; then
    printf '%s\n' "${SETUP_ARGS[@]}" > "$SETUP_FLAGS_FILE"
elif [ -f "$SETUP_FLAGS_FILE" ]; then
    mapfile -t SETUP_ARGS < <(grep -v '^[[:space:]]*$' "$SETUP_FLAGS_FILE" || true)
    if [ ${#SETUP_ARGS[@]} -gt 0 ]; then
        echo "Reusing setup flags: ${SETUP_ARGS[*]}"
    fi
fi

stop_services() {
    # Units may not exist (fresh installs, containers); failures are fine.
    systemctl --user stop "$DAEMON_UNIT" 2>/dev/null || true
    systemctl --user stop "$DAEMON_UNIT_XVF" 2>/dev/null || true
    systemctl --user stop "$TRAY_UNIT" 2>/dev/null || true
}

verify_repo() {
    if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "error: $PROJECT_DIR is not a git checkout." >&2
        exit 1
    fi
    local remote
    remote="$(git -C "$PROJECT_DIR" remote get-url origin 2>/dev/null || true)"
    if [[ "$remote" != *"$REPO_HINT"* ]]; then
        echo "error: origin remote ($remote) does not look like the LVA repository." >&2
        exit 1
    fi
}

rebuild_and_start() {
    echo "Rebuilding virtual environment…"
    rm -rf "$PROJECT_DIR/.venv"

    # config.json is per-device and untracked; bootstrap it from the
    # template when missing (e.g. install predates the untracking).
    local config_file="$PROJECT_DIR/linux_voice_assistant/config.json"
    if [ ! -f "$config_file" ] && [ -f "$PROJECT_DIR/linux_voice_assistant/config.json.example" ]; then
        cp "$PROJECT_DIR/linux_voice_assistant/config.json.example" "$config_file"
        echo "Bootstrapped config.json from config.json.example"
    fi
    if [ -f "$config_file" ]; then
        echo "Migrating config.json…"
        python3 "$PROJECT_DIR/script/migrate_config.py" "$config_file" || {
            echo "Warning: config migration had issues — the daemon will still"
            echo "start, but check the log for unknown-key warnings."
        }
    fi

    cd "$PROJECT_DIR"
    script/setup ${SETUP_ARGS[@]+"${SETUP_ARGS[@]}"}

    systemctl --user start "$DAEMON_UNIT_ACTIVE" 2>/dev/null || true

    echo ""
    echo "Done. Now at: $(git -C "$PROJECT_DIR" describe --tags --always 2>/dev/null || echo "$BRANCH")"
    echo "Check the log for warnings:"
    echo "  journalctl --user -u linux-voice-assistant -f"
    if [ -d "$PARENT_DIR/${PROJECT_NAME}_save" ]; then
        echo ""
        echo "Note: $PARENT_DIR/${PROJECT_NAME}_save is a backup left by the old"
        echo "fresh-clone updater. Once this version works, it can be deleted."
    fi
}

# Pick the daemon unit this device actually runs (XVF3800 devices may use
# the alternative unit), then stop everything related.
DAEMON_UNIT_ACTIVE="$DAEMON_UNIT"
if ! systemctl --user is-active --quiet "$DAEMON_UNIT" 2>/dev/null \
    && systemctl --user is-active --quiet "$DAEMON_UNIT_XVF" 2>/dev/null; then
    DAEMON_UNIT_ACTIVE="$DAEMON_UNIT_XVF"
fi

echo "Project root : $PROJECT_DIR"
echo "Target       : $BRANCH"

if [ "$ROLLBACK" -eq 1 ]; then
    verify_repo
    if [ ! -f "$PREV_REV_FILE" ]; then
        echo "error: no previous revision recorded; nothing to roll back to." >&2
        exit 1
    fi
    PREV_REV="$(cat "$PREV_REV_FILE")"
    echo "Rolling back to: $PREV_REV"
    stop_services
    git -C "$PROJECT_DIR" checkout -B "$BRANCH" "$PREV_REV"
    rm -f "$PREV_REV_FILE"
    echo "Rolled back. Roll forward again later with a normal update."
    rebuild_and_start
    exit 0
fi

verify_repo

if [ "$SKIP_FETCH" -eq 0 ]; then
    # Guard against silently destroying local work: untracked per-device
    # files are fine, modifications to TRACKED files are not.
    if [ "$FORCE" -eq 0 ]; then
        DIRTY="$(git -C "$PROJECT_DIR" status --porcelain --untracked-files=no || true)"
        if [ -n "$DIRTY" ]; then
            echo "Refusing to update: tracked files have local modifications:" >&2
            echo "$DIRTY" >&2
            echo "" >&2
            echo "Commit or stash them, or re-run with --force to discard them." >&2
            exit 1
        fi
    fi

    stop_services

    git -C "$PROJECT_DIR" rev-parse HEAD > "$PREV_REV_FILE"
    echo "Previous revision saved for --rollback: $(cat "$PREV_REV_FILE")"

    echo "Fetching…"
    git -C "$PROJECT_DIR" fetch origin --tags --force
    if git -C "$PROJECT_DIR" rev-parse --verify --quiet "origin/$BRANCH" >/dev/null; then
        git -C "$PROJECT_DIR" checkout -B "$BRANCH" "origin/$BRANCH"
    else
        # Not a remote branch (tag or raw ref); check it out by name.
        git -C "$PROJECT_DIR" checkout -B "$BRANCH" "$BRANCH"
    fi

    # Hand over to the freshly updated copy of this script so the rest of
    # the update runs with the newest update logic (the old copy is the
    # one that was just replaced).
    echo "Handing over to the updated script…"
    exec bash "$SCRIPT_DIR/update_lva" --skip-fetch --branch "$BRANCH" \
        ${SETUP_ARGS[@]+"${SETUP_ARGS[@]}"}
fi

rebuild_and_start
