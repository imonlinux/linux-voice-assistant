[Unit]
Description=Linux Voice Assistant Tray Client
# Bind lifecycle to the graphical session; never pull it up ourselves
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/pi/linux-voice-assistant
ExecStart=/home/pi/linux-voice-assistant/script/tray
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

